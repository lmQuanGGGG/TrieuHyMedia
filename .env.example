# Resend contact-form delivery (optional but recommended for production)
RESEND_API_KEY=

# Verified sender address configured in Resend, for example:
# TRIEU HY MEDIA Website <website@trieuhymedia.net>
CONTACT_FROM_EMAIL=

# Optional: lets the /telegram-media worker route load Hỷ Garden menu images
# from the Telegram storage group. Set this as a Cloudflare Worker secret in
# production, never commit the actual bot token.
TELEGRAM_BOT_TOKEN=
